/* ---- General App Theme ---- */
QWidget {
    background-color: #1E1E1E;
    color: #E0E0E0;
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 13px;
}

/* ---- Buttons ---- */
QPushButton {
    background-color: #2D2D2D;
    border: 1px solid #3A3A3A;
    border-radius: 8px;
    padding: 6px 12px;
    color: #E0E0E0;
}
QPushButton:hover {
    background-color: #3A3A3A;
}
QPushButton:pressed {
    background-color: #505050;
}

/* ---- Input Fields ---- */
QLineEdit {
    background-color: #2B2B2B;
    border: 1px solid #3A3A3A;
    border-radius: 6px;
    padding: 4px 8px;
    color: #E0E0E0;
}

/* ---- Table ---- */
QTableWidget {
    background-color: #252525;
    gridline-color: #3A3A3A;
    border: 1px solid #3A3A3A;
    selection-background-color: #3C3C3C;
}
QHeaderView::section {
    background-color: #2D2D2D;
    color: #C0C0C0;
    padding: 4px;
    border: none;
}
